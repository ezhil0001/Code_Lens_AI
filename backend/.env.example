# ============================================================================
# CodeLens_AI - Environment Configuration Template (CONSOLIDATED)
# 
# SINGLE SOURCE OF TRUTH for all environment variables.
# Copy this file to .env and fill in values for your environment.
# 
# Defined in: backend/app/core/config.py (unified configuration module)
# 
# ============================================================================

# ==================== APPLICATION SETTINGS ====================

APP_NAME=CodeLens_AI
DEBUG=false
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1

# ==================== DATABASE CONFIGURATION ====================

DATABASE_URL=postgresql://postgres:xxxxxx@localhost:5432/codelens_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ==================== JWT & SECURITY ====================

SECRET_KEY=your-super-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=1
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== JWT BLACKLIST (REDIS) ====================

REDIS_URL=redis://localhost:6379/0
ENABLE_JWT_BLACKLIST=true
JWT_BLACKLIST_CACHE_TTL=86400

# ==================== VECTOR DATABASE ====================

CHROMA_URL=http://localhost:8000
CHROMA_API_KEY=

# ==================== LLM & EMBEDDINGS ====================

OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ==================== RATE LIMITING ====================

RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=60
GENERAL_RATE_LIMIT=100
GENERAL_RATE_LIMIT_WINDOW=60

# ==================== OPENTELEMETRY & TRACING ====================

OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
JAEGER_HOST=localhost
JAEGER_PORT=6831

# ==================== LANGFUSE (LLM OBSERVABILITY & EVALUATION) ====================
# Primary LLM observability platform. Self-host with:
#   docker compose -f docker-compose.langfuse.yml --env-file .env.langfuse up -d
# Then open http://localhost:3000, create a project, and paste its keys below.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# Optional trace metadata / behaviour
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_DEBUG=false
LANGFUSE_FLUSH_TIMEOUT_SECONDS=5

# ==================== CORS CONFIGURATION ====================

CORS_ORIGINS=http://localhost:4200,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ==================== LOGGING ====================

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== COMPLIANCE & AUDIT ====================

ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=90
ENABLE_SOFT_DELETE=true
ENABLE_API_VERSIONING=true

# ============================================================================
# NOTES:
#
# 1. PRODUCTION CHECKLIST:
#    - Generate a new SECRET_KEY using:
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
#    - Set ENVIRONMENT=production
#    - Set DEBUG=false
#    - Use strong DATABASE passwords
#    - Enable OTEL_ENABLED=true for monitoring
#    - Set CORS_ORIGINS to your actual domain
#
# 2. LOCAL DEVELOPMENT:
#    - Use the defaults provided (localhost services)
#    - Set DEBUG=true for development
#    - ENVIRONMENT=development is fine
#
# 3. API KEYS & SECRETS:
#    - GROQ_API_KEY: Get from https://console.groq.com/keys
#    - HUGGINGFACE_API_KEY: Get from https://huggingface.co/settings/tokens
#    - OPENAI_API_KEY: Optional (only if using OpenAI as fallback)
#
# 4. DATABASE:
#    - PostgreSQL 13+ required
#    - pgVector extension installed for vector similarity
#    - Format: postgresql://user:password@host:port/database
#
# 5. REDIS:
#    - Required for JWT blacklist if ENABLE_JWT_BLACKLIST=true
#    - Optional if using in-memory cache instead
#
# 6. VECTOR DATABASE:
#    - Chroma API must be running and accessible
#    - Used for embeddings and similarity search
#
# ============================================================================

# Session Configuration
MAX_SESSIONS_PER_USER=5
SESSION_TIMEOUT_MINUTES=1440

# ===================================
# Security Configuration
# ===================================

# API Key for authentication
API_KEY=your-api-key-here

# HTTPS/SSL Configuration
ENABLE_HTTPS=False
SSL_CERT_FILE=certs/cert.pem
SSL_KEY_FILE=certs/key.pem

# CORS Allowed Methods
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ===================================
# Caching Configuration
# ===================================

# Redis URL (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
CACHE_TTL=3600
